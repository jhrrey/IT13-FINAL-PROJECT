<?xml version="1.0" encoding="utf-8" ?>
<!-- 4. "Our care": heading row plus a 3-column bordered grid of service cards. -->
<sections:SectionView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                      xmlns:sections="clr-namespace:VetCare.Views.Sections"
                      xmlns:models="clr-namespace:VetCare.Models"
                      x:Class="VetCare.Views.Sections.ServicesView"
                      x:DataType="models:ServicesContent">

    <VerticalStackLayout x:Name="Container" HorizontalOptions="Center" Padding="0,120">

        <Grid x:Name="HeaderGrid"
              ColumnDefinitions="*,*"
              RowDefinitions="Auto,Auto"
              ColumnSpacing="40"
              RowSpacing="20"
              Margin="0,0,0,60">

            <VerticalStackLayout>
                <Label Text="{Binding Eyebrow}" StyleClass="eyebrow" Margin="0,0,0,18" />
                <Label x:Name="TitleLabel" StyleClass="h2">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding TitleLine1}" FontFamily="NunitoExtraBold" TextColor="{StaticResource Navy}" CharacterSpacing="-0.34" />
                            <Span Text="&#10;" />
                            <Span Text="{Binding TitleAccent}" FontFamily="NunitoExtraBold" TextColor="{StaticResource Orange}" CharacterSpacing="-0.34" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </VerticalStackLayout>

            <!-- Aligned to the bottom of the heading -->
            <Label x:Name="IntroLabel"
                   Grid.Column="1"
                   Text="{Binding Intro}"
                   StyleClass="intro"
                   MaximumWidthRequest="440"
                   HorizontalOptions="End"
                   VerticalOptions="End" />
        </Grid>

        <!-- Filled by ServicesView.BuildGrid -->
        <Grid x:Name="CardsGrid" ColumnSpacing="0" RowSpacing="0" />
    </VerticalStackLayout>
</sections:SectionView>
