<?xml version="1.0" encoding="utf-8" ?>
<!-- Add / Edit owner form, shown in the 440px side panel (SidePanelHost).
     Fields are built in OwnerFormView.xaml.cs. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:VetCare.Views.Controls"
             x:Class="VetCare.Views.Shared.OwnerFormView">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Grid Padding="24,18" ColumnDefinitions="*,Auto">
            <Label x:Name="TitleLabel"
                   FontFamily="NunitoExtraBold"
                   FontSize="24"
                   TextColor="{StaticResource Navy}"
                   VerticalOptions="Center" />
            <Border x:Name="CloseButton"
                    Grid.Column="1"
                    WidthRequest="40"
                    HeightRequest="40"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="Transparent"
                    SemanticProperties.Description="Close">
                <controls:LucideIcon Icon="x"
                                     StrokeColor="{StaticResource NavyMuted}"
                                     WidthRequest="20"
                                     HeightRequest="20"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center" />
            </Border>
            <BoxView Grid.ColumnSpan="2"
                     HeightRequest="1"
                     Color="{StaticResource BorderColor}"
                     VerticalOptions="End"
                     Margin="-24,0,-24,-18" />
        </Grid>

        <!-- Fields -->
        <ScrollView x:Name="FormScroll" Grid.Row="1">
            <VerticalStackLayout Padding="24,20" Spacing="18">
                <VerticalStackLayout x:Name="FieldsStack" Spacing="18" />

                <!-- Duplicate contact warning (rule 5) -->
                <Border x:Name="DuplicateBox"
                        IsVisible="False"
                        Padding="14,12"
                        BackgroundColor="{StaticResource WarningBox}"
                        Stroke="{StaticResource WarningBorder}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <controls:LucideIcon Icon="circle-alert"
                                             StrokeColor="{StaticResource Warning}"
                                             WidthRequest="18"
                                             HeightRequest="18"
                                             VerticalOptions="Start"
                                             Margin="0,2,0,0" />
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label x:Name="DuplicateLabel" FontSize="14" TextColor="{StaticResource Warning}" />
                            <controls:TextLink x:Name="ViewDuplicateLink"
                                               Text="View owner"
                                               StyleClass="link-accent"
                                               FontSize="14" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Label x:Name="MessageLabel"
                       IsVisible="False"
                       FontFamily="DMSansMedium"
                       FontSize="14"
                       TextColor="{StaticResource Danger}" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Footer -->
        <VerticalStackLayout Grid.Row="2" Padding="24,16" Spacing="10">
            <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" Margin="-24,-16,-24,6" />
            <controls:HoverButton x:Name="SaveButton" Style="{StaticResource WorkspaceButton}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <controls:HoverButton x:Name="CancelButton" Style="{StaticResource OutlineButton}" Text="Cancel" />
                <controls:HoverButton x:Name="SaveAndAddPetButton" Grid.Column="1" Style="{StaticResource NavyOutlineButton}" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentView>
