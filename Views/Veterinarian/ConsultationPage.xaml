<?xml version="1.0" encoding="utf-8" ?>
<!-- Consultation page (the vet's working screen): pet summary on the left, consultation form on the right.
     Cards and rows are built in ConsultationPage.xaml.cs. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:VetCare.Views.Controls"
             x:Class="VetCare.Views.Veterinarian.ConsultationPage">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Top bar -->
        <Grid Padding="40,20,40,16" ColumnDefinitions="*,Auto" RowSpacing="6">
            <VerticalStackLayout Spacing="8">
                <HorizontalStackLayout x:Name="BackLink" Spacing="6" HorizontalOptions="Start">
                    <controls:LucideIcon Icon="arrow-left" StrokeColor="{StaticResource Navy}" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                    <controls:TextLink x:Name="BackText" StyleClass="link" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="14">
                    <Label x:Name="TitleLabel" FontFamily="NunitoExtraBold" FontSize="26" TextColor="{StaticResource Navy}" VerticalOptions="Center" />
                    <ContentView x:Name="StatusHost" VerticalOptions="Center" />
                    <Label x:Name="TimerLabel" FontSize="14" TextColor="{StaticResource BodyText}" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
            <BoxView Grid.ColumnSpan="2" HeightRequest="1" Color="{StaticResource BorderColor}" VerticalOptions="End" Margin="-40,0,-40,-16" />
        </Grid>

        <!-- Pet summary (left) and consultation form (right); stacked on narrow widths -->
        <ScrollView x:Name="PageScroll" Grid.Row="1">
            <Grid x:Name="ColumnsGrid" Padding="40,20,40,28" ColumnDefinitions="340,*" ColumnSpacing="20" RowSpacing="20">
                <VerticalStackLayout x:Name="LeftColumn" Spacing="16" />
                <VerticalStackLayout x:Name="RightColumn" Grid.Column="1" Spacing="16" />
            </Grid>
        </ScrollView>

        <!-- Footer: always visible -->
        <Grid Grid.Row="2" Padding="40,14" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" BackgroundColor="{StaticResource Surface}">
            <BoxView Grid.ColumnSpan="3" HeightRequest="1" Color="{StaticResource BorderColor}" VerticalOptions="Start" Margin="-40,-14,-40,0" />
            <Label x:Name="SavedLabel" FontSize="14" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
            <controls:HoverButton x:Name="SecondaryButton" Grid.Column="1" Style="{StaticResource OutlineButton}" Padding="20,0" />
            <controls:HoverButton x:Name="PrimaryButton" Grid.Column="2" Style="{StaticResource WorkspaceButton}" Padding="22,0" />
        </Grid>
    </Grid>
</ContentView>
