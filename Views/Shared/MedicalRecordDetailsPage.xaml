<?xml version="1.0" encoding="utf-8" ?>
<!-- Medical record details (read only) with Print / Book follow-up / Edit / Add note.
     Sections are built in MedicalRecordDetailsPage.xaml.cs. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:VetCare.Views.Controls"
             x:Class="VetCare.Views.Shared.MedicalRecordDetailsPage">

    <ScrollView x:Name="PageScroll">
        <VerticalStackLayout Padding="40,28,40,40" Spacing="20">

            <!-- Back link | buttons -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <HorizontalStackLayout x:Name="BackLink" Spacing="6" HorizontalOptions="Start" VerticalOptions="Center">
                    <controls:LucideIcon Icon="arrow-left" StrokeColor="{StaticResource Navy}" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                    <controls:TextLink x:Name="BackText" Text="Medical records" StyleClass="link" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout x:Name="ButtonsRow" Grid.Column="1" Spacing="10" />
            </Grid>

            <!-- Header card -->
            <Border Style="{StaticResource WorkspaceCard}" Padding="24">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
                    <ContentView x:Name="AvatarHost" VerticalOptions="Start" />
                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                        <Label x:Name="PetNameLabel" FontFamily="NunitoExtraBold" FontSize="24" TextColor="{StaticResource Navy}" />
                        <Label x:Name="PetInfoLabel" FontSize="14" TextColor="{StaticResource BodyText}" />
                        <controls:WrapLayout x:Name="InfoRow" Margin="0,6,0,0" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="8" HorizontalOptions="End">
                        <ContentView x:Name="SyncHost" HorizontalOptions="End" />
                        <HorizontalStackLayout x:Name="LockedRow" Spacing="6" HorizontalOptions="End" IsVisible="False">
                            <controls:LucideIcon Icon="lock" StrokeColor="{StaticResource Muted}" WidthRequest="14" HeightRequest="14" VerticalOptions="Center" />
                            <Label x:Name="LockedLabel" Text="Locked" FontSize="13" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Vital signs -->
            <controls:WrapLayout x:Name="VitalsRow" />

            <VerticalStackLayout x:Name="SectionsStack" Spacing="16" />
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
