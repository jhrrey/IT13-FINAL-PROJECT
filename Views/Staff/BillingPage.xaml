<?xml version="1.0" encoding="utf-8" ?>
<!-- Bills & payments (PHARMACY & BILLING): Ready to bill, Bills and Payments. Rows are built in BillingPage.xaml.cs. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:VetCare.Views.Controls"
             x:Class="VetCare.Views.Staff.BillingPage">

    <ScrollView x:Name="PageScroll">
        <VerticalStackLayout Padding="40,32,40,40" Spacing="20">

            <controls:PageHeader Icon="circle-dollar-sign" Title="Bills &amp; payments" Subtitle="Clear bills, easy payments, happy goodbyes." Margin="0,0,0,4" />

            <Grid x:Name="SummaryGrid" ColumnSpacing="16" RowSpacing="16" />

            <Grid HeightRequest="40">
                <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" VerticalOptions="End" />
                <HorizontalStackLayout x:Name="TabsRow" Spacing="28" />
            </Grid>

            <!-- Toolbar (its fields change with the tab) -->
            <Border Style="{StaticResource WorkspaceCard}" Padding="14">
                <Grid x:Name="Toolbar" ColumnSpacing="12">
                    <Border x:Name="SearchBox" Style="{StaticResource InputBox}" HeightRequest="44" Padding="12,0">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <controls:LucideIcon Icon="search" StrokeColor="{StaticResource Muted}" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                            <Entry x:Name="SearchEntry" Grid.Column="1" Style="{StaticResource InputEntry}" />
                        </Grid>
                    </Border>
                    <Border x:Name="StatusBox" Style="{StaticResource InputBox}" HeightRequest="44" Padding="6,0">
                        <Picker x:Name="StatusPicker" FontFamily="DMSans" FontSize="15" TextColor="{StaticResource Navy}" BackgroundColor="Transparent" VerticalOptions="Center" />
                    </Border>
                    <Border x:Name="MethodBox" Style="{StaticResource InputBox}" HeightRequest="44" Padding="6,0">
                        <Picker x:Name="MethodPicker" FontFamily="DMSans" FontSize="15" TextColor="{StaticResource Navy}" BackgroundColor="Transparent" VerticalOptions="Center" />
                    </Border>
                    <controls:HoverButton x:Name="ClearDatesButton" Style="{StaticResource OutlineButton}" Text="All dates" HeightRequest="44" Padding="14,0" />
                    <controls:DateBox x:Name="FromDate" Placeholder="From" />
                    <controls:DateBox x:Name="ToDate" Placeholder="To" />
                </Grid>
            </Border>

            <Border Style="{StaticResource WorkspaceCard}" Padding="0">
                <VerticalStackLayout>
                    <ScrollView x:Name="TableScroll" Orientation="Horizontal">
                        <VerticalStackLayout x:Name="TableStack" />
                    </ScrollView>
                    <ContentView x:Name="TableState" IsVisible="False" />
                    <Grid x:Name="TotalBar" Padding="20,14" IsVisible="False" BackgroundColor="{StaticResource InputBackground}">
                        <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" VerticalOptions="Start" Margin="-20,-14,-20,0" />
                        <Label x:Name="TotalLabel" FontFamily="DMSansBold" FontSize="15" TextColor="{StaticResource Navy}" HorizontalOptions="End" />
                    </Grid>
                    <Grid x:Name="PagerRow" Padding="20,14" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" IsVisible="False">
                        <BoxView Grid.ColumnSpan="3" HeightRequest="1" Color="{StaticResource BorderColor}" VerticalOptions="Start" Margin="-20,-14,-20,0" />
                        <Label x:Name="PagerLabel" FontSize="14" TextColor="{StaticResource BodyText}" VerticalOptions="Center" />
                        <controls:HoverButton x:Name="PrevButton" Grid.Column="1" Style="{StaticResource OutlineButton}" Text="Prev" HeightRequest="36" Padding="14,0" />
                        <controls:HoverButton x:Name="NextButton" Grid.Column="2" Style="{StaticResource OutlineButton}" Text="Next" HeightRequest="36" Padding="14,0" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
