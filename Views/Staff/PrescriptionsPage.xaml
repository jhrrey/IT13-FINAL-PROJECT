<?xml version="1.0" encoding="utf-8" ?>
<!-- Prescriptions (PHARMACY & BILLING): "To dispense" grouped per visit, and the dispensed history.
     Rows are built in PrescriptionsPage.xaml.cs. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:VetCare.Views.Controls"
             x:Class="VetCare.Views.Staff.PrescriptionsPage">

    <ScrollView x:Name="PageScroll">
        <VerticalStackLayout Padding="40,32,40,40" Spacing="20">

            <controls:PageHeader Icon="pill" Title="Prescriptions" Subtitle="From the vet's note to the owner's hands." Margin="0,0,0,4" />

            <Grid x:Name="SummaryGrid" ColumnSpacing="16" RowSpacing="16" />

            <Grid HeightRequest="40">
                <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" VerticalOptions="End" />
                <HorizontalStackLayout x:Name="TabsRow" Spacing="28" />
            </Grid>

            <Border Style="{StaticResource WorkspaceCard}" Padding="14">
                <Grid ColumnDefinitions="*,Auto,150,150,190" ColumnSpacing="12">
                    <Border Style="{StaticResource InputBox}" HeightRequest="44" Padding="12,0">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <controls:LucideIcon Icon="search" StrokeColor="{StaticResource Muted}" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                            <Entry x:Name="SearchEntry" Grid.Column="1" Style="{StaticResource InputEntry}" Placeholder="Search pet, owner, or medicine" />
                        </Grid>
                    </Border>
                    <controls:HoverButton x:Name="ClearDatesButton" Grid.Column="1" Style="{StaticResource OutlineButton}" Text="All dates" HeightRequest="44" Padding="14,0" />
                    <controls:DateBox x:Name="FromDate" Grid.Column="2" Placeholder="From" />
                    <controls:DateBox x:Name="ToDate" Grid.Column="3" Placeholder="To" />
                    <Border Grid.Column="4" Style="{StaticResource InputBox}" HeightRequest="44" Padding="6,0">
                        <Picker x:Name="VetPicker" FontFamily="DMSans" FontSize="15" TextColor="{StaticResource Navy}" BackgroundColor="Transparent" VerticalOptions="Center" />
                    </Border>
                </Grid>
            </Border>

            <Border Style="{StaticResource WorkspaceCard}" Padding="0">
                <VerticalStackLayout>
                    <ScrollView x:Name="TableScroll" Orientation="Horizontal">
                        <VerticalStackLayout x:Name="TableStack" />
                    </ScrollView>
                    <ContentView x:Name="TableState" IsVisible="False" />
                    <Grid x:Name="PagerRow" Padding="20,14" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" IsVisible="False">
                        <BoxView Grid.ColumnSpan="3" HeightRequest="1" Color="{StaticResource BorderColor}" VerticalOptions="Start" Margin="-20,-14,-20,0" />
                        <Label x:Name="PagerLabel" FontSize="14" TextColor="{StaticResource BodyText}" VerticalOptions="Center" />
                        <controls:HoverButton x:Name="PrevButton" Grid.Column="1" Style="{StaticResource OutlineButton}" Text="Prev" HeightRequest="36" Padding="14,0" />
                        <controls:HoverButton x:Name="NextButton" Grid.Column="2" Style="{StaticResource OutlineButton}" Text="Next" HeightRequest="36" Padding="14,0" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
