<?xml version="1.0" encoding="utf-8" ?>
<!-- User details, shown in the 440px side panel (SidePanelHost). -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:VetCare.Views.Controls"
             x:Class="VetCare.Views.Shared.UserDetailsView">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header: avatar, name, email, close -->
        <Grid Padding="24,20" ColumnDefinitions="56,*,Auto" ColumnSpacing="14">
            <Border WidthRequest="56"
                    HeightRequest="56"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{StaticResource Cyan}">
                <Label x:Name="AvatarLabel"
                       FontFamily="DMSansBold"
                       FontSize="20"
                       TextColor="{StaticResource Navy}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                <Label x:Name="NameLabel"
                       FontFamily="NunitoExtraBold"
                       FontSize="22"
                       TextColor="{StaticResource Navy}"
                       LineBreakMode="TailTruncation" />
                <Label x:Name="EmailLabel" FontSize="14" TextColor="{StaticResource Muted}" LineBreakMode="TailTruncation" />
            </VerticalStackLayout>
            <Border x:Name="CloseButton"
                    Grid.Column="2"
                    WidthRequest="40"
                    HeightRequest="40"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="Transparent"
                    VerticalOptions="Start"
                    SemanticProperties.Description="Close">
                <controls:LucideIcon Icon="x"
                                     StrokeColor="{StaticResource NavyMuted}"
                                     WidthRequest="20"
                                     HeightRequest="20"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center" />
            </Border>
            <BoxView Grid.ColumnSpan="3"
                     HeightRequest="1"
                     Color="{StaticResource BorderColor}"
                     VerticalOptions="End"
                     Margin="-24,0,-24,-20" />
        </Grid>

        <!-- Profile rows (built in code) -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="Rows" Padding="24,20" Spacing="16" />
        </ScrollView>

        <!-- Actions -->
        <VerticalStackLayout Grid.Row="2" Padding="24,16" Spacing="10">
            <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" Margin="-24,-16,-24,6" />
            <Label x:Name="ReadOnlyNote"
                   IsVisible="False"
                   FontSize="13"
                   TextColor="{StaticResource Muted}"
                   HorizontalTextAlignment="Center" />
            <Grid x:Name="ActionsGrid" ColumnDefinitions="*,*" ColumnSpacing="10">
                <controls:HoverButton x:Name="EditButton" Style="{StaticResource OutlineButton}" Text="Edit" />
                <controls:HoverButton x:Name="ResetButton" Grid.Column="1" Style="{StaticResource OutlineButton}" Text="Reset password" />
            </Grid>
            <controls:HoverButton x:Name="StatusButton" Style="{StaticResource DangerButton}" />
        </VerticalStackLayout>
    </Grid>
</ContentView>
