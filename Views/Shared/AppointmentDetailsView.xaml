<?xml version="1.0" encoding="utf-8" ?>
<!-- Appointment details (460px side panel). Content and buttons are built in AppointmentDetailsView.xaml.cs. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:VetCare.Views.Controls"
             x:Class="VetCare.Views.Shared.AppointmentDetailsView">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header: status pill + sync badge, close -->
        <Grid Padding="24,18" ColumnDefinitions="*,Auto">
            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                <ContentView x:Name="StatusHost" VerticalOptions="Center" />
                <ContentView x:Name="SyncHost" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Border x:Name="CloseButton"
                    Grid.Column="1"
                    WidthRequest="40"
                    HeightRequest="40"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="Transparent"
                    SemanticProperties.Description="Close">
                <controls:LucideIcon Icon="x"
                                     StrokeColor="{StaticResource NavyMuted}"
                                     WidthRequest="20"
                                     HeightRequest="20"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center" />
            </Border>
            <BoxView Grid.ColumnSpan="2"
                     HeightRequest="1"
                     Color="{StaticResource BorderColor}"
                     VerticalOptions="End"
                     Margin="-24,0,-24,-18" />
        </Grid>

        <ScrollView x:Name="FormScroll" Grid.Row="1">
            <VerticalStackLayout x:Name="Body" Padding="24,20" Spacing="20" />
        </ScrollView>

        <!-- Footer: actions allowed for this status and role -->
        <VerticalStackLayout x:Name="Footer" Grid.Row="2" Padding="24,16" Spacing="10">
            <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" Margin="-24,-16,-24,6" />
            <Label x:Name="MessageLabel"
                   IsVisible="False"
                   FontFamily="DMSansMedium"
                   FontSize="14"
                   TextColor="{StaticResource Danger}" />
            <Grid x:Name="ButtonsGrid" ColumnSpacing="10" RowSpacing="10" />
        </VerticalStackLayout>
    </Grid>
</ContentView>
