<?xml version="1.0" encoding="utf-8" ?>
<!-- Pet profile (opens when a pet card or row is clicked). Tab contents are built in PetDetailsPage.xaml.cs. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:VetCare.Views.Controls"
             x:Class="VetCare.Views.Staff.PetDetailsPage">

    <ScrollView>
        <VerticalStackLayout Padding="40,28,40,40" Spacing="20">

            <!-- Back link -->
            <HorizontalStackLayout x:Name="BackLink" Spacing="6" HorizontalOptions="Start">
                <controls:LucideIcon Icon="arrow-left"
                                     StrokeColor="{StaticResource Navy}"
                                     WidthRequest="18"
                                     HeightRequest="18"
                                     VerticalOptions="Center" />
                <controls:TextLink x:Name="BackText" Text="Pets" StyleClass="link" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Header card (wide) and owner card (narrow); stacked on small widths -->
            <Grid x:Name="HeaderGrid" ColumnDefinitions="*,300" RowDefinitions="Auto" ColumnSpacing="16" RowSpacing="16">
                <Border Style="{StaticResource WorkspaceCard}" Padding="24">
                    <!-- Row 0: name | buttons. Row 1: species · breed and sync, then the info chips (full width). -->
                    <Grid x:Name="PetHeaderGrid" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="20">
                        <ContentView x:Name="AvatarHost" Grid.RowSpan="2" VerticalOptions="Start" />

                        <Label x:Name="NameLabel"
                               Grid.Column="1"
                               FontFamily="NunitoExtraBold"
                               FontSize="28"
                               CharacterSpacing="-0.3"
                               TextColor="{StaticResource Navy}"
                               LineBreakMode="TailTruncation"
                               VerticalOptions="Center" />

                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2,0,0">
                            <HorizontalStackLayout Spacing="12">
                                <Label x:Name="SpeciesLabel" FontSize="15" TextColor="{StaticResource BodyText}" VerticalOptions="Center" />
                                <ContentView x:Name="SyncHost" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <controls:WrapLayout x:Name="ChipsRow" Margin="0,14,0,0" />
                        </VerticalStackLayout>

                        <HorizontalStackLayout x:Name="ButtonsRow" Grid.Column="2" Spacing="10" VerticalOptions="Start">
                            <controls:HoverButton x:Name="EditButton" Style="{StaticResource OutlineButton}" Text="Edit" />
                            <controls:HoverButton x:Name="BookButton" Style="{StaticResource WorkspaceButton}" Text="Book appointment" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <Border x:Name="OwnerCard" Grid.Column="1" Style="{StaticResource WorkspaceCard}" Padding="22">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="OWNER"
                               FontFamily="DMSansBold"
                               FontSize="12"
                               CharacterSpacing="0.67"
                               TextColor="{StaticResource Muted}" />
                        <Label x:Name="OwnerNameLabel"
                               FontFamily="DMSansBold"
                               FontSize="17"
                               TextColor="{StaticResource Navy}"
                               LineBreakMode="TailTruncation" />
                        <HorizontalStackLayout Spacing="8">
                            <controls:LucideIcon Icon="phone"
                                                 StrokeColor="{StaticResource Muted}"
                                                 WidthRequest="16"
                                                 HeightRequest="16"
                                                 VerticalOptions="Center" />
                            <Label x:Name="OwnerContactLabel" FontSize="14" TextColor="{StaticResource BodyText}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout x:Name="ViewOwnerLink" Spacing="6" Margin="0,6,0,0" HorizontalOptions="Start">
                            <controls:TextLink x:Name="ViewOwnerText" Text="View owner" StyleClass="link-accent" FontSize="14" VerticalOptions="Center" />
                            <controls:LucideIcon Icon="arrow-right"
                                                 StrokeColor="{StaticResource Orange}"
                                                 WidthRequest="16"
                                                 HeightRequest="16"
                                                 VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Stat chips -->
            <FlexLayout x:Name="StatsRow" Wrap="Wrap" JustifyContent="Start" />

            <!-- Tabs -->
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <Grid HeightRequest="40">
                    <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" VerticalOptions="End" />
                    <HorizontalStackLayout x:Name="TabsRow" Spacing="28" />
                </Grid>
            </ScrollView>

            <ContentView x:Name="TabContent" />
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
