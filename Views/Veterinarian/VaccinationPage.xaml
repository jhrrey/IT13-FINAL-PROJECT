<?xml version="1.0" encoding="utf-8" ?>
<!-- Vaccinations (PET CARE → Vaccinations): the due & overdue follow-up list and all records.
     Rows are built in VaccinationPage.xaml.cs. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:VetCare.Views.Controls"
             x:Class="VetCare.Views.Veterinarian.VaccinationPage">

    <ScrollView x:Name="PageScroll">
        <VerticalStackLayout Padding="40,32,40,40" Spacing="20">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="0,0,0,4">
                <controls:PageHeader Icon="shield-check" Title="Vaccinations" Subtitle="Keep every shot on time, and every pet protected." />
                <controls:IconTextButton x:Name="PrintDueButton" Grid.Column="1" Icon="printer" Text="Print due list" Outline="True" VerticalOptions="End" />
            </Grid>

            <!-- Summary cards (Due in 30 days / Overdue filter the due list) -->
            <Grid x:Name="SummaryGrid" ColumnSpacing="16" RowSpacing="16" />

            <!-- Tabs -->
            <Grid HeightRequest="40">
                <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" VerticalOptions="End" />
                <HorizontalStackLayout x:Name="TabsRow" Spacing="28" />
            </Grid>

            <!-- Tab 1: Due & overdue -->
            <VerticalStackLayout x:Name="DueSection" Spacing="16">
                <Border Style="{StaticResource WorkspaceCard}" Padding="14">
                    <Grid x:Name="DueToolbar" ColumnDefinitions="*,190,160" ColumnSpacing="12">
                        <controls:WrapLayout x:Name="ChipsRow" VerticalOptions="Center" />
                        <Border Grid.Column="1" Style="{StaticResource InputBox}" HeightRequest="44" Padding="6,0">
                            <Picker x:Name="DueVaccinePicker" FontFamily="DMSans" FontSize="15" TextColor="{StaticResource Navy}" BackgroundColor="Transparent" VerticalOptions="Center" />
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource InputBox}" HeightRequest="44" Padding="6,0">
                            <Picker x:Name="SpeciesPicker" FontFamily="DMSans" FontSize="15" TextColor="{StaticResource Navy}" BackgroundColor="Transparent" VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Border>
                <Border Style="{StaticResource WorkspaceCard}" Padding="0">
                    <VerticalStackLayout>
                        <ScrollView x:Name="DueScroll" Orientation="Horizontal">
                            <VerticalStackLayout x:Name="DueStack" />
                        </ScrollView>
                        <ContentView x:Name="DueState" IsVisible="False" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Tab 2: All records -->
            <VerticalStackLayout x:Name="RecordsSection" Spacing="16" IsVisible="False">
                <Border Style="{StaticResource WorkspaceCard}" Padding="14">
                    <Grid ColumnDefinitions="*,150,150,190,190" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                        <Border Grid.ColumnSpan="5" Style="{StaticResource InputBox}" HeightRequest="44" Padding="12,0">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <controls:LucideIcon Icon="search" StrokeColor="{StaticResource Muted}" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                                <Entry x:Name="SearchEntry" Grid.Column="1" Style="{StaticResource InputEntry}" Placeholder="Search pet or owner" />
                            </Grid>
                        </Border>
                        <controls:HoverButton x:Name="ClearDatesButton" Grid.Row="1" Style="{StaticResource OutlineButton}" Text="All dates" HeightRequest="44" Padding="14,0" HorizontalOptions="Start" />
                        <controls:DateBox x:Name="FromDate" Grid.Row="1" Grid.Column="1" Placeholder="From" />
                        <controls:DateBox x:Name="ToDate" Grid.Row="1" Grid.Column="2" Placeholder="To" />
                        <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource InputBox}" HeightRequest="44" Padding="6,0">
                            <Picker x:Name="RecordVaccinePicker" FontFamily="DMSans" FontSize="15" TextColor="{StaticResource Navy}" BackgroundColor="Transparent" VerticalOptions="Center" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource InputBox}" HeightRequest="44" Padding="6,0">
                            <Picker x:Name="VetPicker" FontFamily="DMSans" FontSize="15" TextColor="{StaticResource Navy}" BackgroundColor="Transparent" VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Border>
                <Border Style="{StaticResource WorkspaceCard}" Padding="0">
                    <VerticalStackLayout>
                        <ScrollView x:Name="RecordsScroll" Orientation="Horizontal">
                            <VerticalStackLayout x:Name="RecordsStack" />
                        </ScrollView>
                        <ContentView x:Name="RecordsState" IsVisible="False" />
                        <Grid x:Name="PagerRow" Padding="20,14" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" IsVisible="False">
                            <BoxView Grid.ColumnSpan="3" HeightRequest="1" Color="{StaticResource BorderColor}" VerticalOptions="Start" Margin="-20,-14,-20,0" />
                            <Label x:Name="PagerLabel" FontSize="14" TextColor="{StaticResource BodyText}" VerticalOptions="Center" />
                            <controls:HoverButton x:Name="PrevButton" Grid.Column="1" Style="{StaticResource OutlineButton}" Text="Prev" HeightRequest="36" Padding="14,0" />
                            <controls:HoverButton x:Name="NextButton" Grid.Column="2" Style="{StaticResource OutlineButton}" Text="Next" HeightRequest="36" Padding="14,0" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
